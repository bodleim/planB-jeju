# cp .env.example .env.local 후 값 채우기 (Next.js 는 .env.local 을 읽는다)
#
# 런타임에 실제로 필요한 키는 DATA_GO_KR_KEY 하나다 (기상청 단기예보/특보).
# 나머지는 스냅샷 수집 스크립트(scripts/snapshot.py)에서만 쓴다.

# 공공데이터포털 일반 인증키(Decoding) — 기상청/버스/공항/관광공사 전부 이 키 하나
# https://www.data.go.kr  (가입 즉시 발급, 활용신청 후 1시간 내 활성)
DATA_GO_KR_KEY=

# 비짓제주 관광정보 — 사용신청서 제출 후 메일로 키 수신 (수일 소요, 가장 먼저 신청할 것)
# https://www.visitjeju.net/kr/visitjejuapi
VISITJEJU_KEY=

# 제주 ITS 실시간 교통정보 — data.go.kr 15093660 은 링크만, 실제 키는 제주도 ITS 에서 별도 승인
# http://www.jejuits.go.kr/open_api/open_apiView.do  (신청 → 담당자 승인, 1~3일)
JEJU_ITS_KEY=

# 카카오 REST API 키 (지오코딩 + 카카오모빌리티 길찾기)
# https://developers.kakao.com  앱 생성 → REST API 키. 모빌리티는 별도 활성화 필요
KAKAO_REST_KEY=

# https://console.anthropic.com  — 설명 문구 생성 전용. 사실 생성 금지 (CLAUDE.md 규칙)
ANTHROPIC_API_KEY=
