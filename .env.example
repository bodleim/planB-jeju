# cp .env.example .env.local 후 값 채우기 (Next.js 는 .env.local 을 읽는다)
#
# 런타임에 실제로 필요한 키는 DATA_GO_KR_KEY 하나다 (기상청 단기예보/특보).
# 나머지는 스냅샷 수집 스크립트(scripts/snapshot.py)와 지도 렌더링에서만 쓴다.
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출된다.
#    카카오 JavaScript 키는 도메인 제한이 걸려 있어 괜찮지만, 나머지 키에는 절대 붙이지 말 것.

# ---------------------------------------------------------------- 필수

# 공공데이터포털 일반 인증키 — 반드시 Decoding 키.
# Encoding 키를 넣으면 _get() 의 urlencode 가 다시 인코딩해서 %25 이중인코딩으로 깨진다.
# https://www.data.go.kr  (가입 즉시 발급, 활용신청 자동승인 후 ~1시간 내 활성)
#
# 이 키 하나로 아래 활용신청 건을 전부 커버한다 (2026-07-27 승인 완료):
#   - 기상청_단기예보 조회서비스           런타임 실시간
#   - 기상청_기상특보 조회서비스           런타임 실시간
#   - 한국관광공사_국문 관광정보 서비스_GW  15101578 / KorService2 — 비짓제주 대체
#   - 국토교통부_(TAGO)_버스정류소정보
#   - 국토교통부_(TAGO)_버스도착정보
DATA_GO_KR_KEY=

# ---------------------------------------------------------------- 선택 (없어도 시연은 돈다)

# 카카오 REST API 키 — 지오코딩(dapi.kakao.com). 서버 전용.
# https://developers.kakao.com  내 애플리케이션 → 앱 생성 → 앱 설정 > 앱 키
# ⚠️ 키를 넣는 것만으로는 안 된다. 콘솔에서 카카오맵 서비스를 켜야 REST·JS 둘 다 살아난다:
#   앱 설정 > 카카오맵 > 활성화 ON  (안 켜면 403 "disabled OPEN_MAP_AND_LOCAL service")
# 관광공사 응답에 좌표가 있으면 지오코딩은 없어도 된다.
# 길찾기(apis-navi.kakaomobility.com)는 카카오모빌리티 디벨로퍼스에서 별도 이용신청이라 제외.
KAKAO_REST_KEY=

# 카카오 JavaScript 키 — 지도 렌더링. 같은 앱의 다른 키다.
# 앱 설정 > 플랫폼 > Web 에 아래 두 개를 모두 등록해야 지도가 뜬다:
#   http://localhost:3000
#   https://<배포주소>.vercel.app
# 하나라도 빠지면 그 환경에서만 지도가 안 뜬다
# (localhost 로 리허설하고 Vercel 로 발표하면 무대에서 처음 깨진다).
NEXT_PUBLIC_KAKAO_JS_KEY=

# https://console.anthropic.com  — 설명 문구 생성 전용. 사실 생성 금지 (CLAUDE.md 규칙)
# Billing 에 결제수단을 등록해야 키가 실제로 동작한다. 설명은 고정 템플릿이 기본이라 없어도 된다.
ANTHROPIC_API_KEY=

# https://aistudio.google.com/apikey — '직접 말하기' 자유 문장 해석 (src/lib/llm-intent.ts).
# 무료 쿼터로 충분하다 (결제수단 불필요). 문장 → 구조화된 입력 + '후보 목록에서 id 고르기' 만
# 한다. 사실 생성 금지 (CLAUDE.md 규칙). 없으면 키워드 표(prompt.ts) 폴백으로 동작하므로
# 시연이 죽지 않는다. NEXT_PUBLIC_ 금지 (서버 전용).
GEMINI_API_KEY=
# 기본 gemini-2.5-flash. 바꾸려면: GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------- 승인 대기 (2026-07-27 기준 미발급)
#
# 아래 둘은 승인에 수일이 걸려 이번 시연 범위에서 빠졌다.
# 비워두면 check() 가 실패가 아닌 `--` 로 건너뛴다.

# 비짓제주 관광정보 — 사용신청서 제출 후 메일 회신 (수일)
# → 한국관광공사 국문 관광정보 서비스(DATA_GO_KR_KEY)로 대체했다.
# https://www.visitjeju.net/kr/visitjejuapi
VISITJEJU_KEY=

# 제주 ITS 실시간 교통정보 — 제주도 담당자 승인 (1~3일)
# → 없으면 geo.ts 의 거리 기반 이동시간 추정을 그대로 쓴다.
# http://www.jejuits.go.kr/open_api/open_apiView.do
JEJU_ITS_KEY=
